<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Pinned explicitly so a clone builds identically regardless of the machine's global
    NuGet configuration. Reproducible builds are a Charter commitment (Article VIII), and
    that starts with a deterministic package graph.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

</configuration>
