<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      The only test project that reaches GamerGod.Windows. GamerGod.Core.Tests deliberately
      cannot, because keeping the domain unable to touch a real machine is what makes the
      ledger's chaos tests possible.
    -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GamerGod.Service\GamerGod.Service.csproj" />
  </ItemGroup>

</Project>
