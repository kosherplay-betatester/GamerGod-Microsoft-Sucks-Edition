<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>godmode</AssemblyName>
    <RootNamespace>GodMode.Cli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!--
      AOT compatibility is analysed but not enforced at publish time. Keeping the analyzers
      on is what caught the journal's reflection-based JSON, which would have failed only
      after trimming - that is, only in a shipped build, only during crash recovery.

      Publishing is self-contained instead: a user should be able to download GodMode and
      run it without first being told to install a .NET runtime. Native AOT additionally
      requires the C++ build tools, which is a reasonable ask of a contributor and an
      unreasonable one of a player.
    -->
    <IsAotCompatible>true</IsAotCompatible>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GodMode.Core\GodMode.Core.csproj" />
    <ProjectReference Include="..\GodMode.Windows\GodMode.Windows.csproj" />
  </ItemGroup>

</Project>
