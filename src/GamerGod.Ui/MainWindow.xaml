<Window x:Class="GamerGod.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GamerGod"
        Width="1180" Height="760"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource Body}">

    <!--
        Custom chrome. Windows' default title bar cannot be tinted to match an instrument
        enclosure, and a light bar above a dark panel is the single most common thing that makes
        a WPF application look unfinished.
    -->
    <Border x:Name="Shell"
            Background="{StaticResource Ground}"
            BorderBrush="{StaticResource Line}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--
                ==================== Atmosphere ====================
                Behind everything and never hit-testable. Flat near-black reads as cheap at
                this window size, and the fix is not colour but depth: two very low-opacity
                lights, warm from the top left where the rest of this interface is lit from,
                cool from the bottom right so the amber has something to be warm against.
                Over that, an engineering grid at 3% — invisible until you look for it, and
                the reason the panel feels like a surface rather than a void.
            -->
            <Grid Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False">
                <Rectangle>
                    <Rectangle.Fill>
                        <RadialGradientBrush GradientOrigin="0.15,0.05" Center="0.15,0.05"
                                             RadiusX="1.1" RadiusY="1.1">
                            <GradientStop Color="#1AFFB454" Offset="0" />
                            <GradientStop Color="#00FFB454" Offset="1" />
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Rectangle>
                    <Rectangle.Fill>
                        <RadialGradientBrush GradientOrigin="0.95,1" Center="0.95,1"
                                             RadiusX="0.9" RadiusY="0.9">
                            <GradientStop Color="#146FD3FF" Offset="0" />
                            <GradientStop Color="#006FD3FF" Offset="1" />
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Rectangle Opacity="0.5">
                    <Rectangle.Fill>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,34,34"
                                      ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <GeometryDrawing Brush="#06FFFFFF">
                                    <GeometryDrawing.Geometry>
                                        <GeometryGroup>
                                            <RectangleGeometry Rect="0,0,34,1" />
                                            <RectangleGeometry Rect="0,0,1,34" />
                                        </GeometryGroup>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>

            <!-- ==================== Title bar ==================== -->
            <Grid Grid.Row="0" Height="46" Background="#B00D1017"
                  MouseLeftButtonDown="TitleBar_Drag">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0"
                            VerticalAlignment="Center">
                    <!--
                        The stacked GG, matching the application icon: a hollow G behind and
                        above, a solid one in front and below. Clipped to the enclosure for the
                        same reason the icon is — a mark that leaks out of its own frame reads
                        as a mistake.
                    -->
                    <Border Width="28" Height="28" CornerRadius="4"
                            BorderBrush="{StaticResource Signal}" BorderThickness="1"
                            Background="{StaticResource SignalGlow}"
                            ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="G" FontFamily="{StaticResource Display}" FontSize="13"
                                       FontWeight="Bold" Foreground="{StaticResource SignalDim}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="0,0,7,7" />
                            <TextBlock Text="G" FontFamily="{StaticResource Display}" FontSize="13"
                                       FontWeight="Bold" Foreground="{StaticResource Signal}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="7,7,0,0" />
                        </Grid>
                    </Border>
                    <TextBlock Text="GamerGod" FontFamily="{StaticResource Display}" FontSize="14"
                               FontWeight="Bold" Foreground="{StaticResource Ink}"
                               VerticalAlignment="Center" Margin="10,0,0,0" />

                    <!--
                        The edition name, and it is meant to be read. It was a footnote in
                        InkFaint before, which is the colour this interface uses for things
                        that do not matter — the one piece of attitude in the whole product,
                        greyed out like a disclaimer.
                    -->
                    <Border Margin="12,0,0,0" Padding="8,2,8,3" CornerRadius="3"
                            VerticalAlignment="Center"
                            Background="{StaticResource SignalGlow}"
                            BorderBrush="{StaticResource SignalDim}" BorderThickness="1">
                        <TextBlock FontFamily="{StaticResource Display}" FontSize="10.5"
                                   FontWeight="SemiBold" Foreground="{StaticResource Signal}"
                                   Text="MICROSOFT SUCKS EDITION" />
                    </Border>

                    <TextBlock x:Name="Quip" FontSize="11.5" FontStyle="Italic"
                               Foreground="{StaticResource InkDim}"
                               VerticalAlignment="Center" Margin="11,1,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource ChromeButton}" Content="&#xE921;"
                            FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Click="Minimise_Click" ToolTip="Minimise" />
                    <Button x:Name="MaximiseButton" Style="{StaticResource ChromeButton}"
                            Content="&#xE922;"
                            FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Click="Maximise_Click" ToolTip="Maximise" />
                    <Button Style="{StaticResource ChromeButton}" Content="&#xE8BB;"
                            FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Click="Close_Click" ToolTip="Close" />
                </StackPanel>
            </Grid>

            <!-- ==================== Body ==================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="172" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Navigation -->
                <!-- Translucent so the atmosphere reads through it and the rail feels like
                     glass over the panel rather than a second opaque box. -->
                <Border Grid.Column="0" Background="#8A0D1017"
                        BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                    <DockPanel Margin="10,14,10,14">
                        <StackPanel DockPanel.Dock="Top">
                            <RadioButton x:Name="NavDashboard" Style="{StaticResource NavButton}"
                                         Content="Dashboard" IsChecked="True"
                                         Checked="Nav_Changed" Tag="Dashboard" />
                            <RadioButton x:Name="NavLibrary" Style="{StaticResource NavButton}"
                                         Content="Library"
                                         Checked="Nav_Changed" Tag="Library" />
                            <RadioButton x:Name="NavGetMore" Style="{StaticResource NavButton}"
                                         Content="Get more"
                                         Checked="Nav_Changed" Tag="GetMore" />
                            <RadioButton x:Name="NavMachine" Style="{StaticResource NavButton}"
                                         Content="Your machine"
                                         Checked="Nav_Changed" Tag="Machine" />
                            <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}"
                                         Content="Settings"
                                         Checked="Nav_Changed" Tag="Settings" />
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Bottom">
                            <TextBlock Style="{StaticResource Mono}" Text="v1.0.0"
                                       Margin="13,0,0,4" />
                            <TextBlock Style="{StaticResource Mono}" Text="GPLv3 · no telemetry"
                                       FontSize="10.5" Foreground="{StaticResource InkFaint}"
                                       Margin="13,0,0,0" />
                        </StackPanel>

                        <Grid />
                    </DockPanel>
                </Border>

                <!-- Pages -->
                <Grid Grid.Column="1">

                    <!-- ============ Dashboard ============ -->
                    <ScrollViewer x:Name="PageDashboard" VerticalScrollBarVisibility="Auto"
                                  Padding="26,22,26,26">
                        <StackPanel>

                            <!-- The one control the product is meant to have. -->
                            <Border Style="{StaticResource Card}" Padding="22">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="StateHeadline" Style="{StaticResource H1}"
                                                   Text="Game Mode is off" />
                                        <TextBlock x:Name="StateDetail" Style="{StaticResource BodyText}"
                                                   Margin="0,7,24,0"
                                                   Text="Nothing on your machine is being changed. Turn this on and everything else moves out of your games' way." />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <CheckBox x:Name="MasterSwitch" Style="{StaticResource Switch}"
                                                  Click="MasterSwitch_Click"
                                                  HorizontalAlignment="Right" />
                                        <TextBlock x:Name="SwitchLabel" Style="{StaticResource Mono}"
                                                   Text="OFF" FontSize="10.5"
                                                   HorizontalAlignment="Right" Margin="0,7,2,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- What just happened. The receipt. -->
                            <Border x:Name="ReceiptCard" Style="{StaticResource Card}"
                                    Margin="0,14,0,0" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Eyebrow}" Text="RECEIPT" />
                                    <TextBlock x:Name="ReceiptText" Style="{StaticResource BodyText}"
                                               Foreground="{StaticResource Ink}" />
                                    <ItemsControl x:Name="ReceiptItems" Margin="0,10,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Style="{StaticResource Mono}" Text="{Binding}"
                                                           Margin="0,2,0,0" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- The core map: the thing nobody else can draw. -->
                            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Style="{StaticResource Eyebrow}" Text="CORE MAP" />
                                        <TextBlock x:Name="TopologyKind" Style="{StaticResource Mono}"
                                                   HorizontalAlignment="Right" FontSize="10.5" />
                                    </Grid>
                                    <TextBlock x:Name="ProcessorName" Style="{StaticResource H2}"
                                               Margin="0,0,0,3" />
                                    <TextBlock x:Name="ProcessorDetail" Style="{StaticResource Mono}"
                                               Margin="0,0,0,14" />
                                    <ItemsControl x:Name="Domains" />
                                </StackPanel>
                            </Border>

                            <!-- Article VII, on screen rather than only in the Charter. -->
                            <Border Style="{StaticResource Card}" Margin="0,14,0,0"
                                    Background="{StaticResource Raised}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Eyebrow}" Text="UNMEASURED" />
                                    <TextBlock Style="{StaticResource BodyText}"
                                               Text="GamerGod will tell you what it changed. It will not tell you how many frames you gained, because it cannot measure that yet — and a number nobody measured is the thing that ruined this category. When the measurement harness lands you will get a real figure with error bars, and if it turns out to be zero, it will say zero." />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ============ Library ============ -->
                    <Grid x:Name="PageLibrary" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                                      Padding="26,22,26,26">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Eyebrow}" Text="LIBRARY" />
                                <TextBlock Style="{StaticResource H1}" Text="Everything you play" />
                                <TextBlock x:Name="LibraryBlurb" Style="{StaticResource BodyText}"
                                           Margin="0,7,0,0" />

                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button Style="{StaticResource GhostButton}" Content="REFRESH"
                                            Click="Library_Refresh" />
                                    <Button x:Name="GetArtButton" Style="{StaticResource GhostButton}"
                                            Content="GET COVER ART" Margin="8,0,0,0"
                                            Click="GetArt_Click" />
                                    <TextBlock x:Name="LibraryCount" Style="{StaticResource Mono}"
                                               VerticalAlignment="Center" Margin="14,0,0,0" />
                                </StackPanel>

                                <!--
                                    A grid of 2:3 portrait tiles at the ratio stores publish
                                    their art in, so real covers fill the frame exactly and
                                    never letterbox. The chrome recedes deliberately: the box
                                    art supplies all the colour on this page, and the instrument
                                    shell is just the rack it sits in.
                                -->
                                <ItemsControl x:Name="LibraryItems" Margin="0,18,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource TileButton}"
                                                    Click="Tile_Click"
                                                    Tag="{Binding}"
                                                    ToolTip="{Binding Name}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock x:Name="LibraryEmpty" Style="{StaticResource BodyText}"
                                           Margin="0,18,0,0" Visibility="Collapsed" />
                            </StackPanel>
                        </ScrollViewer>

                        <!--
                            The launch tray. Picking a tile is free; this is where the
                            consequences live. It states what will happen to the machine
                            immediately next to the control that causes it, rather than leaving
                            a click on box art to silently reconfigure a CPU.
                        -->
                        <Border x:Name="LaunchTray" Grid.Row="1" Visibility="Collapsed"
                                Background="{StaticResource Sunk}"
                                BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
                                Padding="26,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border x:Name="TrayThumb" Grid.Column="0" Width="38" Height="57"
                                        CornerRadius="3" ClipToBounds="True"
                                        VerticalAlignment="Center"
                                        BorderBrush="{StaticResource Line}" BorderThickness="1">
                                    <Grid>
                                        <TextBlock x:Name="TrayInitial"
                                                   FontFamily="{StaticResource Display}"
                                                   FontSize="20" FontWeight="Bold"
                                                   Foreground="#33FFFFFF"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        <Image x:Name="TrayCover" Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                            Margin="14,0,18,0">
                                    <TextBlock x:Name="TraySource" Style="{StaticResource Eyebrow}"
                                               Margin="0,0,0,3" />
                                    <TextBlock x:Name="TrayName" Style="{StaticResource H2}"
                                               FontSize="15" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="TrayNote" Style="{StaticResource BodyText}"
                                               FontSize="12" Margin="0,4,0,0" />
                                </StackPanel>

                                <Button Grid.Column="2" Style="{StaticResource GhostButton}"
                                        Content="CLEAR" VerticalAlignment="Center"
                                        Margin="0,0,10,0" Click="ClearSelection_Click" />

                                <Button x:Name="LaunchButton" Grid.Column="3"
                                        Style="{StaticResource LaunchButton}"
                                        Content="LAUNCH" VerticalAlignment="Center"
                                        Click="Launch_Click" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ============ Get more ============ -->
                    <ScrollViewer x:Name="PageGetMore" VerticalScrollBarVisibility="Auto"
                                  Padding="26,22,26,26" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Eyebrow}" Text="INSTALL" />
                            <TextBlock Style="{StaticResource H1}" Text="Emulators and launchers" />
                            <TextBlock Style="{StaticResource BodyText}" Margin="0,7,0,0"
                                       Text="Every install runs through the Windows Package Manager, which checks the publisher and the SHA-256 of every file before it writes anything. GamerGod hosts nothing and mirrors nothing — it knows the names, Windows does the downloading, and anything installed here uninstalls the same way." />

                            <Border Style="{StaticResource Card}" Margin="0,14,0,0"
                                    Background="{StaticResource Raised}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Eyebrow}" Text="BEFORE YOU START" />
                                    <TextBlock Style="{StaticResource BodyText}"
                                               Text="Emulators are legal. The games you run on them are your own business, and GamerGod will not help with that part — there are no ROMs here and no links to any. Several consoles also need a BIOS dumped from hardware you own; the entries that do are marked, because an emulator that boots to a black screen looks broken to somebody who was never told why." />
                                    <TextBlock x:Name="SwitchNote" Style="{StaticResource BodyText}"
                                               Margin="0,9,0,0"
                                               Foreground="{StaticResource InkFaint}" />
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="CatalogueStatus" Style="{StaticResource Mono}"
                                       Margin="0,16,0,0" />

                            <ItemsControl x:Name="CatalogueItems" Margin="0,4,0,0" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ============ Your machine ============ -->
                    <ScrollViewer x:Name="PageMachine" VerticalScrollBarVisibility="Auto"
                                  Padding="26,22,26,26" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Eyebrow}" Text="ENVIRONMENT SCAN" />
                            <TextBlock Style="{StaticResource H1}" Text="Your machine" />
                            <TextBlock Style="{StaticResource BodyText}" Margin="0,7,0,0"
                                       Text="Read-only. This changes nothing — it looks for things quietly costing you frames, and for anything that would stop a game launching." />

                            <Button Style="{StaticResource GhostButton}" Content="RUN SCAN"
                                    HorizontalAlignment="Left" Margin="0,16,0,0"
                                    Click="Scan_Click" />

                            <ItemsControl x:Name="Hazards" Margin="0,18,0,0" />

                            <TextBlock x:Name="ScanEmpty" Style="{StaticResource BodyText}"
                                       Margin="0,18,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ============ Settings ============ -->
                    <ScrollViewer x:Name="PageSettings" VerticalScrollBarVisibility="Auto"
                                  Padding="26,22,26,26" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Eyebrow}" Text="SETTINGS" />
                            <TextBlock Style="{StaticResource H1}" Text="Settings" />

                            <!-- Levers -->
                            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Eyebrow}" Text="WHAT GAMERGOD DOES" />

                                    <Grid Margin="0,4,0,0">
                                        <StackPanel Margin="0,0,70,0">
                                            <TextBlock Style="{StaticResource H2}" FontSize="13.5"
                                                       Text="Move background apps off your game's cores" />
                                            <TextBlock Style="{StaticResource BodyText}" FontSize="12.5"
                                                       Text="The main one. On a CPU with more than one performance domain this is worth more than everything else combined." />
                                        </StackPanel>
                                        <CheckBox x:Name="OptConfine" Style="{StaticResource Switch}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Click="Setting_Changed" />
                                    </Grid>

                                    <Rectangle Height="1" Fill="{StaticResource LineSoft}" Margin="0,14,0,14" />

                                    <Grid>
                                        <StackPanel Margin="0,0,70,0">
                                            <TextBlock Style="{StaticResource H2}" FontSize="13.5"
                                                       Text="Set background apps to efficiency mode" />
                                            <TextBlock Style="{StaticResource BodyText}" FontSize="12.5"
                                                       Text="Windows' own mechanism — the same one Task Manager exposes. Reversible and invisible to your game." />
                                        </StackPanel>
                                        <CheckBox x:Name="OptEfficiency" Style="{StaticResource Switch}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Click="Setting_Changed" />
                                    </Grid>

                                    <Rectangle Height="1" Fill="{StaticResource LineSoft}" Margin="0,14,0,14" />

                                    <Grid>
                                        <StackPanel Margin="0,0,70,0">
                                            <TextBlock Style="{StaticResource H2}" FontSize="13.5"
                                                       Text="Pause the search indexer and update checks" />
                                            <TextBlock Style="{StaticResource BodyText}" FontSize="12.5"
                                                       Text="Off by default, honestly: on a healthy machine the measured effect is close to nothing. It helps most if you get occasional hitches while Windows is busy." />
                                        </StackPanel>
                                        <CheckBox x:Name="OptServices" Style="{StaticResource Switch}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Click="Setting_Changed" />
                                    </Grid>

                                    <Rectangle Height="1" Fill="{StaticResource LineSoft}" Margin="0,14,0,14" />

                                    <Grid>
                                        <StackPanel Margin="0,0,70,0">
                                            <TextBlock Style="{StaticResource H2}" FontSize="13.5"
                                                       Text="Use a high-performance power plan" />
                                            <TextBlock Style="{StaticResource BodyText}" FontSize="12.5"
                                                       Text="Your own plan is never edited — a copy is made and activated, then yours comes back. Small effect on a desktop." />
                                        </StackPanel>
                                        <CheckBox x:Name="OptPower" Style="{StaticResource Switch}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Click="Setting_Changed" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Sound -->
                            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Eyebrow}" Text="SOUND" />

                                    <Grid Margin="0,4,0,0">
                                        <StackPanel Margin="0,0,70,0">
                                            <TextBlock Style="{StaticResource H2}" FontSize="13.5"
                                                       Text="Interface sounds" />
                                            <TextBlock Style="{StaticResource BodyText}" FontSize="12.5"
                                                       Text="Short tones generated in software — nothing is bundled and nothing plays during a game." />
                                        </StackPanel>
                                        <CheckBox x:Name="OptSound" Style="{StaticResource Switch}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Click="Sound_Toggled" />
                                    </Grid>

                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource Mono}"
                                                   Text="VOLUME" VerticalAlignment="Center"
                                                   Margin="0,0,14,0" />
                                        <Slider x:Name="OptVolume" Grid.Column="1"
                                                Style="{StaticResource Slider}"
                                                Minimum="0" Maximum="100" Value="45"
                                                VerticalAlignment="Center"
                                                ValueChanged="Volume_Changed" />
                                        <TextBlock x:Name="VolumeLabel" Grid.Column="2"
                                                   Style="{StaticResource Mono}" Text="45"
                                                   VerticalAlignment="Center" Width="30"
                                                   TextAlignment="Right" Margin="12,0,12,0" />
                                        <Button Grid.Column="3" Style="{StaticResource GhostButton}"
                                                Content="TEST" Padding="11,5"
                                                Click="TestSound_Click" />
                                    </Grid>

                                    <Grid Margin="0,16,0,0">
                                        <StackPanel Margin="0,0,70,0">
                                            <TextBlock Style="{StaticResource H2}" FontSize="13.5"
                                                       Text="Click and hover ticks" />
                                            <TextBlock Style="{StaticResource BodyText}" FontSize="12.5"
                                                       Text="Very quiet by design. Turn it off if you would rather have only the on and off tones." />
                                        </StackPanel>
                                        <CheckBox x:Name="OptNavSound" Style="{StaticResource Switch}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Click="Setting_Changed" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Behaviour -->
                            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Eyebrow}" Text="BEHAVIOUR" />

                                    <Grid Margin="0,4,0,0">
                                        <StackPanel Margin="0,0,70,0">
                                            <TextBlock Style="{StaticResource H2}" FontSize="13.5"
                                                       Text="Show me what will change first" />
                                            <TextBlock Style="{StaticResource BodyText}" FontSize="12.5"
                                                       Text="Preview every change and wait for you to confirm before anything is applied." />
                                        </StackPanel>
                                        <CheckBox x:Name="OptConfirm" Style="{StaticResource Switch}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Click="Setting_Changed" />
                                    </Grid>

                                    <Rectangle Height="1" Fill="{StaticResource LineSoft}" Margin="0,14,0,14" />

                                    <Grid>
                                        <StackPanel Margin="0,0,70,0">
                                            <TextBlock Style="{StaticResource H2}" FontSize="13.5"
                                                       Text="Turn Game Mode on when GamerGod starts" />
                                            <TextBlock Style="{StaticResource BodyText}" FontSize="12.5"
                                                       Text="Skip the switch. Rebooting still undoes everything." />
                                        </StackPanel>
                                        <CheckBox x:Name="OptArmOnLaunch" Style="{StaticResource Switch}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Click="Setting_Changed" />
                                    </Grid>

                                    <Rectangle Height="1" Fill="{StaticResource LineSoft}" Margin="0,14,0,14" />

                                    <Grid>
                                        <StackPanel Margin="0,0,70,0">
                                            <TextBlock Style="{StaticResource H2}" FontSize="13.5"
                                                       Text="Download missing cover art" />
                                            <TextBlock Style="{StaticResource BodyText}" FontSize="12.5"
                                                       Text="The only thing in GamerGod that uses the internet, and it is off until you switch it on. It asks a public store CDN for one image per game, by store id, with no account and no identifier attached — then keeps the file so it never asks again. Turning this off stops all outbound traffic; art already downloaded stays." />
                                        </StackPanel>
                                        <CheckBox x:Name="OptCoverArt" Style="{StaticResource Switch}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Click="Setting_Changed" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- What cannot be changed. Stated, not hidden. -->
                            <Border Style="{StaticResource Card}" Margin="0,14,0,0"
                                    Background="{StaticResource Raised}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Eyebrow}" Text="NOT ADJUSTABLE, ON PURPOSE" />
                                    <TextBlock Style="{StaticResource BodyText}"
                                               Text="There is no setting here that weakens a safety list, and no way to make GamerGod touch a game protected by kernel anti-cheat. Fan and pump control, system-critical processes, VR runtimes, remote-desktop hosts, accessibility software and anti-cheat services are never touched, whatever else is switched on." />
                                    <TextBlock Style="{StaticResource BodyText}" Margin="0,9,0,0"
                                               Text="Those are not oversights. An override for the thermal list would be the one that cooked a laptop, and a force flag on the anti-cheat policy would be the one that got somebody's account flagged." />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
