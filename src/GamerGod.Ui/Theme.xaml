<!--
    GamerGod's visual identity.

    The product's whole argument is measurement over marketing, so it is dressed as a precision
    instrument rather than gamer hardware: an oscilloscope, motorsport telemetry, a mixing desk.

    Two clichés are avoided deliberately. RGB-everything gamer chrome, because it would
    contradict the tone of a tool that admits when a lever does nothing. And near-black with a
    lone acid-green accent, because it is the default look of every optimiser ever shipped.

    Signal amber is the accent — a warning-lamp colour, unusual in this category and readable
    against a cool ground. Cool blue is reserved for data traces and appears nowhere else, so a
    blue line always means measured data. Semantic colour is a separate set from the accent.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================ Palette ============================ -->

    <Color x:Key="GroundColor">#0A0C11</Color>
    <Color x:Key="SurfaceColor">#12161E</Color>
    <Color x:Key="RaisedColor">#1A1F2A</Color>
    <Color x:Key="SunkColor">#0D1017</Color>
    <Color x:Key="LineColor">#262D3B</Color>
    <Color x:Key="LineSoftColor">#1C2230</Color>

    <Color x:Key="InkColor">#E8EBF2</Color>
    <Color x:Key="InkDimColor">#8892A6</Color>
    <Color x:Key="InkFaintColor">#5A6377</Color>

    <Color x:Key="SignalColor">#FFB454</Color>
    <Color x:Key="SignalDimColor">#8A6428</Color>

    <Color x:Key="TraceColor">#6FD3FF</Color>
    <Color x:Key="GoodColor">#3FBF8F</Color>
    <Color x:Key="WarnColor">#E8B04B</Color>
    <Color x:Key="CritColor">#FF6B5B</Color>

    <SolidColorBrush x:Key="Ground" Color="{StaticResource GroundColor}" />
    <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="Raised" Color="{StaticResource RaisedColor}" />
    <SolidColorBrush x:Key="Sunk" Color="{StaticResource SunkColor}" />
    <SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="LineSoft" Color="{StaticResource LineSoftColor}" />
    <SolidColorBrush x:Key="Ink" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="InkDim" Color="{StaticResource InkDimColor}" />
    <SolidColorBrush x:Key="InkFaint" Color="{StaticResource InkFaintColor}" />
    <SolidColorBrush x:Key="Signal" Color="{StaticResource SignalColor}" />
    <SolidColorBrush x:Key="SignalDim" Color="{StaticResource SignalDimColor}" />
    <SolidColorBrush x:Key="SignalGlow" Color="{StaticResource SignalColor}" Opacity="0.14" />
    <SolidColorBrush x:Key="Trace" Color="{StaticResource TraceColor}" />
    <SolidColorBrush x:Key="Good" Color="{StaticResource GoodColor}" />
    <SolidColorBrush x:Key="Warn" Color="{StaticResource WarnColor}" />
    <SolidColorBrush x:Key="Crit" Color="{StaticResource CritColor}" />

    <!-- ============================ Type ==============================
         Bahnschrift is a condensed, DIN-like variable face that ships with Windows 10 and 11,
         so it renders for the actual audience with no webfont and no bundled asset. Cascadia
         Mono carries every numeral, because figures that shift width as they update read as
         unserious on an instrument.
    -->

    <FontFamily x:Key="Display">Bahnschrift, Segoe UI Variable Display, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="Body">Segoe UI Variable Text, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="Data">Cascadia Mono, Consolas, Courier New, monospace</FontFamily>

    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Display}" />
        <Setter Property="FontSize" Value="21" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>

    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Display}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>

    <Style x:Key="Eyebrow" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Display}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{StaticResource InkFaint}" />
        <Setter Property="Margin" Value="0,0,0,7" />
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Body}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource InkDim}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="19" />
    </Style>

    <Style x:Key="Readout" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Data}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>

    <Style x:Key="Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Data}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource InkDim}" />
    </Style>

    <!-- ============================ Surfaces ============================ -->

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- ============================ Controls ============================ -->

    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Display}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource InkDim}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Signal}" />
                            <Setter Property="Foreground" Value="{StaticResource Signal}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Signal}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource InkFaint}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Window chrome buttons: minimal, and never amber - they are not the point of the page. -->
    <Style x:Key="ChromeButton" TargetType="Button">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Foreground" Value="{StaticResource InkFaint}" />
        <Setter Property="FontFamily" Value="{StaticResource Body}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Raised}" />
                            <Setter Property="Foreground" Value="{StaticResource Ink}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavButton" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource Display}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource InkFaint}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="3" Padding="13,9">
                        <Grid>
                            <Rectangle x:Name="Rail" Width="2" HorizontalAlignment="Left"
                                       Fill="{StaticResource Signal}" Visibility="Collapsed" />
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Raised}" />
                            <Setter Property="Foreground" Value="{StaticResource Ink}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SignalGlow}" />
                            <Setter TargetName="Rail" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource Signal}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Raised}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A switch, not a checkbox. This is the one control the product is meant to have. -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Border x:Name="Track" Width="52" Height="26" CornerRadius="13"
                                Background="{StaticResource Sunk}"
                                BorderBrush="{StaticResource Line}" BorderThickness="1" />
                        <!--
                            The knob moves by margin rather than by a RenderTransform. A
                            transform nested inside a property element is not part of the
                            template's namescope, so a trigger cannot address it - margin is
                            plainer and actually works.
                        -->
                        <Border x:Name="Knob" Width="18" Height="18" CornerRadius="9"
                                Background="{StaticResource InkFaint}"
                                HorizontalAlignment="Left" Margin="4,0,0,0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource SignalGlow}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Signal}" />
                            <Setter TargetName="Knob" Property="Background" Value="{StaticResource Signal}" />
                            <Setter TargetName="Knob" Property="Margin" Value="30,0,0,0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource InkDim}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Signal}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Knob" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Slider" TargetType="Slider">
        <Setter Property="Height" Value="24" />
        <Setter Property="Foreground" Value="{StaticResource Signal}" />
        <Setter Property="Background" Value="{StaticResource Sunk}" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
    </Style>

</ResourceDictionary>
