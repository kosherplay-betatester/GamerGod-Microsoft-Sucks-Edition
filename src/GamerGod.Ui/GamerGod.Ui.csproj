<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>GamerGod</AssemblyName>
    <RootNamespace>GamerGod.Ui</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!--
      Overrides the solution-wide default. WPF's font cache constructs CultureInfo("en") while
      measuring text, which invariant globalization forbids, so every TextBlock throws during
      layout and the window renders empty. The command-line tool keeps invariant mode - it is
      smaller and starts faster - but a UI cannot.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- Generated by install\New-Icon.ps1 rather than committed as a binary. -->
    <ApplicationIcon>..\..\install\gamergod.ico</ApplicationIcon>

    <!--
      Self-contained for the same reason the CLI is: a player should be able to run GamerGod
      without first being told to install a runtime. Not single-file, because WPF's own
      assemblies are happier on disk and the installer places them anyway.
    -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GamerGod.Core\GamerGod.Core.csproj" />
    <ProjectReference Include="..\GamerGod.Windows\GamerGod.Windows.csproj" />
  </ItemGroup>

</Project>
