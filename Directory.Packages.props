<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <!--
    Dependencies are kept deliberately minimal and permissively licensed.
    GamerGod ships under GPLv3 and must stay unambiguously redistributable, so we avoid
    packages with commercial or source-available licence terms. Assertions use xUnit's
    built-in Assert rather than FluentAssertions for exactly this reason.
  -->
  <ItemGroup>
    <!--
      MIT, and part of the same .NET release the rest of this repository targets. It is what
      lets gmsvc.exe run as both a Windows service and an ordinary console program, which is
      the difference between debugging boot recovery and guessing at it.
    -->
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.10" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="System.Management" Version="9.0.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>
</Project>